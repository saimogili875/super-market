# Django settings module — use config.settings.dev or config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# SECURITY WARNING: generate a unique secret key for production
SECRET_KEY=change-me-to-a-real-secret-key

# Database Connection String
# Option A: Supabase Postgres (Session Pooler port 5432 or Transaction Pooler port 6543)
# NOTE: Replace <project-ref> and <PASSWORD> with your Supabase credentials. sslmode=require is mandatory.
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Option B: Local Docker PostgreSQL (if running via docker compose)
# DATABASE_URL=postgres://restaurant:restaurant@localhost:5432/restaurant

# Redis connection string (matches docker-compose defaults)
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of allowed hostnames (prod only; dev defaults to ['*'])
ALLOWED_HOSTS=localhost,127.0.0.1

# Admin panel path (moved off default /admin/ to reduce attack surface)
ADMIN_URL=backoffice/
